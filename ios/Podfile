# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '17.0'

# Force RN-related pods to static to avoid duplicate modulemaps / .pch issues
pre_install do |installer|
  installer.pod_targets.each do |pod|
    name = pod.name
    if name =~ /^React/ ||
       name =~ /^RCT/ ||
       name =~ /^FBReact/ ||
       name.include?("ReactCommon") ||
       name.include?("Codegen") ||
       name.include?("Yoga")
      def pod.build_type; Pod::BuildType.static_library; end
    end
  end
end

require_relative '../node_modules/react-native/scripts/react_native_pods'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'HomeDootPartner' do
  config = use_native_modules!

  # Required for Firebase Swift pods when integrating as static libraries
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    :fabric_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :production => false
  )

  # Your normal pods can be added here

  target 'HomeDootPartnerTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Disable strict compilation for all pods
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        config.build_settings['CLANG_WARN_STRICT_PROTOTYPES'] = 'NO'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        # Suppress warnings instead of errors
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      end
    end
  end
end
